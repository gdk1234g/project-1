# Allow only reviewed source files and supporting text.
# Extend this allowlist after subsequent files have been reviewed.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/src/
/src/*
!/src/__init__.py
!/src/model.py
!/src/baseline_losses.py
!/src/baseline_metrics.py
!/src/dataset.py
!/src/baseline_dataset.py
!/src/config.py
!/src/reporting.py
!/src/visualize.py
!/predict.py
!/demo/
/demo/*
!/demo/__init__.py
!/demo/app.py
!/demo/requirements.txt
!/demo/start.cmd
!/demo/static/
/demo/static/*
!/demo/static/index.html
!/demo/static/app.css
!/demo/static/app.js
!/src/experiment.py
!/scripts/
/scripts/*
!/scripts/__init__.py
!/scripts/train_baseline.py
!/scripts/evaluate_validation.py
!/scripts/audit_dataset.py
!/scripts/evaluate_baseline.py
!/scripts/run_training_logged.py

